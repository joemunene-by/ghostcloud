{
  "schema_version": 1,
  "aws": [
    {
      "service": "s3",
      "type": "bucket",
      "id": "arn:aws:s3:::public-data-bucket",
      "region": "us-east-1",
      "config": {
        "acl": "public-read",
        "public_access_block": {
          "block_public_acls": false,
          "block_public_policy": false,
          "ignore_public_acls": false,
          "restrict_public_buckets": false
        },
        "encryption": { "enabled": false },
        "versioning": { "status": "Suspended" }
      }
    },
    {
      "service": "ec2",
      "type": "security_group",
      "id": "sg-0a1b2c3d4e",
      "region": "us-east-1",
      "config": {
        "ingress_rules": [
          { "from_port": 3389, "to_port": 3389, "cidrs": ["0.0.0.0/0"] }
        ]
      }
    },
    {
      "service": "iam",
      "type": "policy",
      "id": "arn:aws:iam::111122223333:policy/AdminAll",
      "region": "",
      "config": {
        "statements": [{ "effect": "Allow", "action": "*", "resource": "*" }]
      }
    }
  ],
  "gcp": [
    {
      "service": "storage",
      "type": "bucket",
      "id": "//storage.googleapis.com/public-assets",
      "region": "us",
      "config": {
        "public_access_prevention": "inherited",
        "iam_bindings": [
          { "role": "roles/storage.objectViewer", "members": ["allUsers"] }
        ]
      }
    },
    {
      "service": "iam",
      "type": "service_account",
      "id": "deploy@demo.iam.gserviceaccount.com",
      "region": "",
      "config": { "roles": ["roles/owner"] }
    }
  ],
  "azure": [
    {
      "service": "network",
      "type": "network_security_group",
      "id": "/subscriptions/abc/resourceGroups/rg1/providers/Microsoft.Network/networkSecurityGroups/nsg1",
      "region": "eastus",
      "config": {
        "security_rules": [
          {
            "direction": "Inbound",
            "access": "Allow",
            "source_address_prefix": "Internet",
            "destination_port_range": "3389"
          }
        ]
      }
    },
    {
      "service": "compute",
      "type": "disk",
      "id": "/subscriptions/abc/resourceGroups/rg1/providers/Microsoft.Compute/disks/disk1",
      "region": "eastus",
      "config": { "encryption": { "enabled": false } }
    }
  ]
}
