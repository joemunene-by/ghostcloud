{
  "schema_version": 1,
  "azure": [
    {
      "service": "storage",
      "type": "storage_account",
      "id": "/subscriptions/abc/resourceGroups/rg1/providers/Microsoft.Storage/storageAccounts/privstg",
      "region": "eastus",
      "config": { "allow_blob_public_access": false }
    },
    {
      "service": "network",
      "type": "network_security_group",
      "id": "/subscriptions/abc/resourceGroups/rg1/providers/Microsoft.Network/networkSecurityGroups/nsg2",
      "region": "eastus",
      "config": {
        "security_rules": [
          {
            "direction": "Inbound",
            "access": "Allow",
            "source_address_prefix": "10.0.0.0/8",
            "destination_port_range": "22"
          },
          {
            "direction": "Inbound",
            "access": "Deny",
            "source_address_prefix": "Internet",
            "destination_port_range": "3389"
          }
        ]
      }
    },
    {
      "service": "compute",
      "type": "disk",
      "id": "/subscriptions/abc/resourceGroups/rg1/providers/Microsoft.Compute/disks/disk2",
      "region": "eastus",
      "config": { "encryption": { "enabled": true, "type": "EncryptionAtRestWithPlatformKey" } }
    }
  ]
}
