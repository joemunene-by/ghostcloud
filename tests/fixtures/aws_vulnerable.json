{
  "schema_version": 1,
  "aws": [
    {
      "service": "s3",
      "type": "bucket",
      "id": "arn:aws:s3:::public-data-bucket",
      "region": "us-east-1",
      "config": {
        "acl": "public-read",
        "public_access_block": {
          "block_public_acls": false,
          "block_public_policy": false,
          "ignore_public_acls": false,
          "restrict_public_buckets": false
        },
        "encryption": { "enabled": false },
        "versioning": { "status": "Suspended" }
      }
    },
    {
      "service": "ec2",
      "type": "security_group",
      "id": "sg-0a1b2c3d4e",
      "region": "us-east-1",
      "config": {
        "ingress_rules": [
          { "from_port": 22, "to_port": 22, "cidrs": ["0.0.0.0/0"] },
          { "from_port": 0, "to_port": 65535, "cidrs": ["0.0.0.0/0"] }
        ]
      }
    },
    {
      "service": "ec2",
      "type": "volume",
      "id": "vol-0123456789",
      "region": "us-east-1",
      "config": { "encrypted": false }
    },
    {
      "service": "iam",
      "type": "user",
      "id": "arn:aws:iam::111122223333:user/alice",
      "region": "",
      "config": { "console_access": true, "mfa_enabled": false }
    },
    {
      "service": "iam",
      "type": "policy",
      "id": "arn:aws:iam::111122223333:policy/AdminAll",
      "region": "",
      "config": {
        "statements": [
          { "effect": "Allow", "action": "*", "resource": "*" }
        ]
      }
    },
    {
      "service": "rds",
      "type": "db_instance",
      "id": "arn:aws:rds:us-east-1:111122223333:db:prod-db",
      "region": "us-east-1",
      "config": { "publicly_accessible": true, "storage_encrypted": false }
    },
    {
      "service": "cloudtrail",
      "type": "trail",
      "id": "arn:aws:cloudtrail:us-east-1:111122223333:trail/main",
      "region": "us-east-1",
      "config": { "is_logging": false, "is_multi_region": false }
    }
  ]
}
